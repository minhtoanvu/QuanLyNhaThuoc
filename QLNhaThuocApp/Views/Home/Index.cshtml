@using QLNhaThuoc.DAL
@model HomeDAL.DashboardData

@{
    ViewData["Title"] = "Tổng Quan Quản Trị";
}

<!-- Thêm Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .metric-card {
        background: linear-gradient(145deg, rgba(30, 41, 59, 1) 0%, rgba(15, 23, 42, 1) 100%);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 24px;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .metric-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    }
    
    .metric-icon {
        position: absolute;
        right: -10px;
        bottom: -10px;
        font-size: 100px;
        opacity: 0.05;
        transform: rotate(-15deg);
    }
    
    .metric-title {
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }
    
    .metric-value {
        font-size: 32px;
        font-weight: 800;
        color: white;
        margin-bottom: 0;
    }
    
    .metric-trend.positive { color: #34D399; }
    .metric-trend.negative { color: #F87171; }
    
    .chart-container {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 24px;
        height: 100%;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .list-group-item-dark {
        background-color: transparent !important;
        border-color: var(--border-color) !important;
        color: var(--text-main);
        padding: 16px 0;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="font-size: 28px; font-weight: 800; color: white;">Dashboard Tổng Quan</h2>
        <p style="color: var(--text-muted); font-size: 15px;">Báo cáo nhanh các chỉ số kinh doanh và hoạt động nhà thuốc.</p>
    </div>
    <div class="text-end">
        <p class="mb-0 text-muted small">Thời gian cập nhật</p>
        <p class="mb-0 fw-bold text-white fs-5">@DateTime.Now.ToString("HH:mm") <span class="text-primary">•</span> @DateTime.Now.ToString("dd/MM/yyyy")</p>
    </div>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<!-- Metrics Row -->
<div class="row g-4 mb-4">
    <!-- Doanh Thu Hôm Nay -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card border-bottom border-primary border-4">
            <i class="fa-solid fa-wallet metric-icon text-primary"></i>
            <div class="metric-title">DOANH THU HÔM NAY</div>
            <div class="metric-value">@Model.DoanhThuHomNay.ToString("N0")<span class="fs-5 text-muted ms-1">₫</span></div>
            <div class="mt-2 text-muted small">
                <i class="fa-solid fa-arrow-trend-up metric-trend positive me-1"></i>
                <span class="text-white">@Model.SoDonHomNay</span> đơn hàng đã bán
            </div>
        </div>
    </div>
    
    <!-- Doanh Thu Tháng -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card border-bottom border-success border-4">
            <i class="fa-solid fa-money-bill-trend-up metric-icon text-success"></i>
            <div class="metric-title">DOANH THU THÁNG LŨY KẾ</div>
            <div class="metric-value">@Model.DoanhThuThang.ToString("N0")<span class="fs-5 text-muted ms-1">₫</span></div>
            <div class="mt-2 text-muted small">
                Cập nhật tức thời theo giao dịch POS
            </div>
        </div>
    </div>
    
    <!-- Khách Hàng -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card border-bottom border-info border-4">
            <i class="fa-solid fa-users metric-icon text-info"></i>
            <div class="metric-title">TỔNG BỆNH NHÂN / VIP</div>
            <div class="metric-value">@Model.TongKhachHang</div>
            <div class="mt-2 text-muted small">
                Hồ sơ lưu trữ trên hệ thống
            </div>
        </div>
    </div>
    
    <!-- Cảnh báo/Sự cố -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="metric-card border-bottom border-warning border-4">
            <i class="fa-solid fa-triangle-exclamation metric-icon text-warning"></i>
            <div class="metric-title">SỰ CỐ CHƯA XỬ LÝ</div>
            <div class="metric-value text-warning">@Model.SuCoChoXuLy</div>
            <div class="mt-2 text-muted small">
                Tickers yêu cầu bộ phận CSKH xử lý
            </div>
        </div>
    </div>
</div>

<!-- Main Content Row -->
<div class="row g-4">
    <!-- Chart -->
    <div class="col-12 col-lg-8">
        <div class="chart-container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-chart-line me-2 text-primary"></i>Biểu Đồ Doanh Thu 7 Ngày Qua</h5>
                <button class="btn btn-sm btn-outline-secondary rounded-pill"><i class="fa-solid fa-expand"></i></button>
            </div>
            <div style="height: 300px; width: 100%;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Low Stock Alert -->
    <div class="col-12 col-lg-4">
        <div class="chart-container overflow-auto" style="max-height: 400px;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-bell me-2 text-warning"></i>Sắp Hết Hàng</h5>
                <span class="badge bg-danger rounded-pill">Tồn < 20</span>
            </div>
            
            <ul class="list-group list-group-flush">
                @if(Model.SanPhamSapHet != null && Model.SanPhamSapHet.Count > 0)
                {
                    foreach(var sp in Model.SanPhamSapHet)
                    {
                        var percent = (sp.Ton / 20.0) * 100;
                        var colorClass = sp.Ton == 0 ? "bg-danger" : "bg-warning";
                        
                        <li class="list-group-item list-group-item-dark border-bottom">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-white text-truncate" style="max-width: 200px;" title="@sp.Ten">@sp.Ten</strong>
                                <span class="badge @colorClass text-dark fw-bold">@sp.Ton</span>
                            </div>
                            <div class="progress bg-secondary" style="height: 6px;">
                                <div class="progress-bar @colorClass" role="progressbar" style="width: @percent%;" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fa-solid fa-boxes-stacked text-muted fs-1 mb-3"></i>
                        <p class="text-muted">Kho hàng dồi dào, không có cảnh báo.</p>
                    </div>
                }
            </ul>
            @if(Model.SanPhamSapHet?.Count >= 6)
            {
                <a href="/SanPham" class="btn btn-sm btn-outline-primary w-100 mt-3">Xem tất cả kho hàng</a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var ctx = document.getElementById('revenueChart').getContext('2d');
            
            // Lấy dữ liệu từ ASP.NET Model gán vào JS
            var labels = [];
            var dataValues = [];
            
            @if(Model.DoanhThu7NgayQua != null)
            {
                foreach(var item in Model.DoanhThu7NgayQua)
                {
                    @:labels.push('@item.Ngay');
                    @:dataValues.push(@item.DoanhThu);
                }
            }

            // Nếu mảng rỗng thì demo tĩnh
            if(labels.length === 0) {
                labels = ["10/04", "11/04", "12/04", "13/04", "14/04", "15/04", "Hôm nay"];
                dataValues = [1200000, 1900000, 1500000, 2200000, 1800000, 3100000, @Model.DoanhThuHomNay == 0 ? 450000 : @Model.DoanhThuHomNay];
            }

            var gradientLine = ctx.createLinearGradient(0, 0, 0, 400);
            gradientLine.addColorStop(0, 'rgba(59, 130, 246, 0.5)'); // primary color with opacity
            gradientLine.addColorStop(1, 'rgba(59, 130, 246, 0.0)');

            var myChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh Số Bán Hàng (VNĐ)',
                        data: dataValues,
                        borderColor: '#3B82F6', // Primary web color
                        backgroundColor: gradientLine,
                        borderWidth: 3,
                        pointBackgroundColor: '#1E293B',
                        pointBorderColor: '#3B82F6',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1E293B',
                            titleColor: '#F8FAFC',
                            bodyColor: '#34D399',
                            borderColor: '#334155',
                            borderWidth: 1,
                            padding: 12,
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed.y !== null) {
                                        label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(255, 255, 255, 0.05)',
                                drawBorder: false,
                            },
                            ticks: {
                                color: '#94A3B8',
                                callback: function(value) {
                                    if(value >= 1000000) return (value/1000000) + ' Tr';
                                    if(value >= 1000) return (value/1000) + ' K';
                                    return value;
                                }
                            }
                        },
                        x: {
                            grid: {
                                color: 'rgba(255, 255, 255, 0.05)',
                                drawBorder: false,
                            },
                            ticks: {
                                color: '#94A3B8'
                            }
                        }
                    },
                    interaction: {
                        intersect: false,
                        mode: 'index',
                    },
                }
            });
        });
    </script>
}
