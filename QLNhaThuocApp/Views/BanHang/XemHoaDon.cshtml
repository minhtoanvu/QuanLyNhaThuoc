@model QLNhaThuoc.DTO.HoaDon
@{
    ViewBag.Title = "Hóa Đơn - " + Model.MaHD;
    var chiTiet = ViewBag.ChiTiet as List<QLNhaThuoc.DTO.ChiTietHoaDon>;
}

<style>
    .invoice-wrapper {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px 0 60px;
    }

    .invoice-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .invoice-header {
        background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 100%);
        color: #fff;
        padding: 32px 40px 28px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .invoice-shop-name {
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .invoice-shop-sub {
        font-size: 0.85rem;
        opacity: 0.85;
    }

    .invoice-badge {
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 10px;
        padding: 12px 20px;
        text-align: right;
    }

    .invoice-badge .label { font-size: 0.75rem; opacity: 0.8; text-transform: uppercase; letter-spacing: 1px; }
    .invoice-badge .maid { font-size: 1.4rem; font-weight: 800; letter-spacing: 1.5px; }
    .invoice-badge .date { font-size: 0.82rem; opacity: 0.85; margin-top: 2px; }

    .invoice-body {
        padding: 32px 40px;
        color: #1a1a2e;
    }

    .invoice-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 28px;
        background: #f8faff;
        border-radius: 12px;
        padding: 20px 24px;
        border: 1px solid #e0eaff;
    }

    .info-block label { font-size: 0.78rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.8px; display: block; margin-bottom: 4px; }
    .info-block span { font-size: 0.97rem; font-weight: 600; color: #1e293b; }

    .invoice-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 24px;
    }

    .invoice-table thead tr {
        background: #1e3a5f;
        color: #fff;
    }

    .invoice-table thead th {
        padding: 12px 16px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .invoice-table tbody tr {
        border-bottom: 1px solid #e8edf5;
        transition: background 0.15s;
    }

    .invoice-table tbody tr:hover { background: #f0f5ff; }

    .invoice-table tbody td {
        padding: 13px 16px;
        font-size: 0.93rem;
        color: #1e293b;
    }

    .invoice-table .row-num { color: #94a3b8; font-size: 0.85rem; width: 32px; }
    .invoice-table .col-money { text-align: right; font-weight: 600; color: #0d6efd; }

    .invoice-summary {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 32px;
    }

    .summary-box {
        background: #f0f5ff;
        border-radius: 12px;
        padding: 20px 28px;
        min-width: 300px;
        border: 1px solid #c7d9ff;
    }

    .sum-row {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        font-size: 0.93rem;
        color: #475569;
    }

    .sum-total {
        display: flex;
        justify-content: space-between;
        padding: 12px 0 0;
        margin-top: 10px;
        border-top: 2px solid #3b82f6;
        font-size: 1.2rem;
        font-weight: 800;
        color: #1e3a5f;
    }

    .invoice-footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 32px;
        padding: 28px 40px 32px;
        background: #f8faff;
        border-top: 1px solid #e0eaff;
    }

    .qr-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .qr-section img {
        width: 150px;
        height: 150px;
        object-fit: contain;
        border-radius: 10px;
        border: 3px solid #3b82f6;
        padding: 4px;
        background: #fff;
    }

    .qr-section .qr-label {
        font-size: 0.78rem;
        color: #475569;
        text-align: center;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .sig-section {
        flex: 1;
        display: flex;
        justify-content: space-around;
        align-items: flex-end;
        gap: 24px;
    }

    .sig-col { text-align: center; }
    .sig-col .sig-title { font-size: 0.8rem; font-weight: 700; color: #1e3a5f; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 60px; }
    .sig-col .sig-line { border-top: 1.5px dashed #94a3b8; width: 140px; margin: 0 auto; }
    .sig-col .sig-name { font-size: 0.75rem; color: #64748b; margin-top: 6px; }

    .action-bar {
        display: flex;
        gap: 12px;
        justify-content: center;
        padding: 24px 0 0;
    }

    .btn-print {
        background: linear-gradient(135deg, #1e3a5f, #2563eb);
        color: #fff;
        border: none;
        padding: 12px 32px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-print:hover { opacity: 0.88; transform: translateY(-1px); }

    .btn-back {
        background: transparent;
        color: var(--text-main, #94a3b8);
        border: 1.5px solid var(--border-color, #334155);
        padding: 12px 28px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.97rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-back:hover { border-color: #3b82f6; color: #3b82f6; }

    @@media print {
        .action-bar { display: none !important; }
        .invoice-wrapper { padding: 0; }
        body { background: #fff !important; }
        nav, aside, header, .sidebar { display: none !important; }
    }
</style>

<div class="invoice-wrapper">

    <div class="action-bar mb-3">
        <a href="/BanHang" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i> Bán Hàng Mới
        </a>
        <a href="/BanHang/LichSu" class="btn-back">
            <i class="fa-solid fa-clock-rotate-left"></i> Lịch Sử
        </a>
        <button class="btn-print" onclick="window.print()">
            <i class="fa-solid fa-print"></i> In Hóa Đơn
        </button>
    </div>

    <div class="invoice-card">
        <!-- HEADER -->
        <div class="invoice-header">
            <div>
                <div class="invoice-shop-name"><i class="fa-solid fa-pills me-2"></i>NHÀ THUỐC QLNhaThuoc</div>
                <div class="invoice-shop-sub">Hệ thống quản lý nhà thuốc chuyên nghiệp</div>
                <div class="invoice-shop-sub mt-1"><i class="fa-solid fa-phone me-1"></i>Hotline: 1800 xxxx &nbsp;&nbsp; <i class="fa-solid fa-location-dot me-1"></i>Địa chỉ nhà thuốc</div>
            </div>
            <div class="invoice-badge">
                <div class="label">HÓA ĐƠN BÁN HÀNG</div>
                <div class="maid">@Model.MaHD</div>
                <div class="date"><i class="fa-regular fa-calendar me-1"></i>@Model.NgayXuatHD.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <!-- BODY -->
        <div class="invoice-body">

            <!-- Thông tin hóa đơn -->
            <div class="invoice-info-grid">
                <div class="info-block">
                    <label>Khách Hàng</label>
                    <span>@Model.TenKhachHang</span>
                </div>
                <div class="info-block">
                    <label>Nhân Viên Lập HĐ</label>
                    <span>@(string.IsNullOrEmpty(Model.TenNhanVien) ? "—" : Model.TenNhanVien)</span>
                </div>
                <div class="info-block">
                    <label>Phương Thức Thanh Toán</label>
                    <span>@Model.PhuongThucThanhToan</span>
                </div>
                <div class="info-block">
                    <label>Ngày Xuất Hóa Đơn</label>
                    <span>@Model.NgayXuatHD.ToString("dd/MM/yyyy HH:mm:ss")</span>
                </div>
            </div>

            <!-- Bảng chi tiết sản phẩm -->
            <table class="invoice-table">
                <thead>
                    <tr>
                        <th class="row-num">#</th>
                        <th>Tên Thuốc / Sản Phẩm</th>
                        <th style="text-align:center;">Đơn Vị</th>
                        <th style="text-align:center;">Số Lượng</th>
                        <th style="text-align:right;">Đơn Giá</th>
                        <th style="text-align:right;">Thành Tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int stt = 1; }
                    @foreach (var item in chiTiet)
                    {
                        <tr>
                            <td class="row-num">@stt</td>
                            <td style="font-weight:600;">@item.SanPham?.TenSP</td>
                            <td style="text-align:center; color:#64748b;">@(item.SanPham?.DonViTinh ?? "—")</td>
                            <td style="text-align:center;">@item.SoLuong</td>
                            <td class="col-money">@item.DonGia.ToString("N0")đ</td>
                            <td class="col-money">@item.ThanhTien.ToString("N0")đ</td>
                        </tr>
                        stt++;
                    }
                </tbody>
            </table>

            <!-- Tổng kết -->
            <div class="invoice-summary">
                <div class="summary-box">
                    <div class="sum-row">
                        <span>Tạm tính</span>
                        <span>@((Model.TongTien + Model.TienGiamTru).ToString("N0"))đ</span>
                    </div>
                    @if (Model.TienGiamTru > 0)
                    {
                        <div class="sum-row" style="color:#e11d48;">
                            <span>Giảm giá</span>
                            <span>- @Model.TienGiamTru.ToString("N0")đ</span>
                        </div>
                    }
                    @if (Model.DiemSuDung > 0)
                    {
                        <div class="sum-row" style="color:#7c3aed;">
                            <span>Điểm sử dụng</span>
                            <span>@Model.DiemSuDung điểm</span>
                        </div>
                    }
                    <div class="sum-total">
                        <span>TỔNG CỘNG</span>
                        <span style="color:#2563eb;">@Model.TongTien.ToString("N0")đ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- FOOTER: QR + Chữ ký -->
        <div class="invoice-footer">
            <div class="qr-section">
                <div class="qr-label"><i class="fa-solid fa-qrcode me-1"></i>Quét QR Thanh Toán</div>
                <img src="/images/qr.jpg" alt="QR Thanh Toán" />
                <div class="qr-label" style="color:#2563eb; font-size:0.72rem;">Chuyển khoản ngân hàng</div>
            </div>

            <div class="sig-section">
                <div class="sig-col">
                    <div class="sig-title">Khách Hàng</div>
                    <div class="sig-line"></div>
                    <div class="sig-name">(Ký và ghi rõ họ tên)</div>
                </div>
                <div class="sig-col">
                    <div class="sig-title">Nhân Viên Bán Hàng</div>
                    <div class="sig-line"></div>
                    <div class="sig-name">(Ký và ghi rõ họ tên)</div>
                </div>
                <div class="sig-col">
                    <div class="sig-title">Quản Lý</div>
                    <div class="sig-line"></div>
                    <div class="sig-name">(Ký và đóng dấu)</div>
                </div>
            </div>
        </div>

    </div><!-- /invoice-card -->

    <div class="action-bar mt-3">
        <a href="/BanHang" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i> Bán Hàng Mới
        </a>
        <a href="/BanHang/LichSu" class="btn-back">
            <i class="fa-solid fa-clock-rotate-left"></i> Lịch Sử
        </a>
        <button class="btn-print" onclick="window.print()">
            <i class="fa-solid fa-print"></i> In Hóa Đơn
        </button>
    </div>

</div>
