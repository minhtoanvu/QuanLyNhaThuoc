@model IEnumerable<QLNhaThuoc.DTO.NhanVien>

@{
    ViewBag.Title = "Quản Lý Nhân Sự";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table-container {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-top: 20px;
    }
    
    table {
        width: 100%;
        border-collapse: collapse;
    }
    
    th, td {
        padding: 16px;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-main);
        vertical-align: middle;
    }
    
    th {
        background-color: rgba(0, 0, 0, 0.2);
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.5px;
    }
    
    tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.03);
    }
    
    .action-icons a {
        color: var(--text-muted);
        margin-right: 10px;
        transition: var(--transition);
        font-size: 18px;
    }
    
    .action-icons a:hover {
        color: var(--primary-color);
    }
    
    .action-icons a.delete-icon:hover {
        color: #ef4444;
    }
    
    .role-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 8px;"><i class="fa-solid fa-users-gear me-2 text-primary"></i>Danh sách Nhân sự</h2>
        <p style="color: var(--text-muted); font-size: 14px;">Quản lý nhân viên, dược sĩ, phân quyền tài khoản đăng nhập.</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="fa-solid fa-plus"></i> Thêm Nhân Viên
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]</div>
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i> @ViewBag.ErrorMessage</div>
}

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Mã NV</th>
                <th>Họ Tên</th>
                <th>Tài Khoản</th>
                <th>Số Điện Thoại</th>
                <th>Chức Vụ</th>
                <th>Lương Base</th>
                <th>Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @if(Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td><strong style="color: var(--text-muted);">@item.MaNV</strong></td>
                        <td><div style="font-weight: 600;">@item.Ho @item.Ten</div></td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.TenDangNhap))
                            {
                                <span class="badge bg-secondary bg-opacity-25 text-info border border-info border-opacity-25">@item.TenDangNhap</span>
                            }
                        </td>
                        <td>@(item.SoDT ?? "-")</td>
                        <td>
                            @if (item.ChucVu == "Admin" || item.ChucVu == "Quản lý")
                            {
                                <span class="role-badge" style="background: rgba(245, 158, 11, 0.15); color: #FBBF24;">@item.ChucVu</span>
                            }
                            else
                            {
                                <span class="role-badge" style="background: rgba(59, 130, 246, 0.15); color: #60A5FA;">@item.ChucVu</span>
                            }
                        </td>
                        <td>@item.Luong.ToString("N0") đ</td>
                        <td>
                            <div class="action-icons">
                                <a href="@Url.Action("Edit", new { id = item.MaNV })" title="Chỉnh sửa"><i class="fa-solid fa-pen-to-square"></i></a>
                                @if (item.TenDangNhap != "admin")
                                {
                                    <a href="@Url.Action("Delete", new { id = item.MaNV })" class="delete-icon" title="Xóa"><i class="fa-solid fa-trash"></i></a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align: center; padding: 30px; color: var(--text-muted);">
                        Chưa có dữ liệu nhân viên.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
