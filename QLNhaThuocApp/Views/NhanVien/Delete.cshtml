@model QLNhaThuoc.DTO.NhanVien

@{
    ViewBag.Title = "Xóa Nhân Viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 mt-4">
        <div class="card bg-dark border-danger shadow-sm rounded-4">
            <div class="card-header border-danger bg-transparent p-4 pb-0">
                <h5 class="text-danger mb-0"><i class="fa-solid fa-user-xmark me-2"></i>Xác nhận Xóa Hồ Sơ Nhân Viên</h5>
            </div>
            
            <div class="card-body p-4 text-white">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mb-4">
                        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <p class="fs-5">Bạn có chắc chắn muốn xóa hồ sơ nhân viên này và toàn bộ quyền truy cập hệ thống của họ không?</p>
                <div class="bg-secondary bg-opacity-10 p-3 rounded-3 mb-4">
                    <p class="mb-2 text-muted small">Mã Nhân Viên: <span class="text-white fw-bold">@Model.MaNV</span></p>
                    <p class="mb-2 text-muted small">Họ Tên: <span class="text-white fw-bold">@Model.Ho @Model.Ten</span></p>
                    <p class="mb-0 text-muted small">Chức Vụ: <span class="text-info fw-bold">@Model.ChucVu</span></p>
                </div>

                <div class="alert alert-warning border-warning">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i><strong>Cảnh báo:</strong> Nếu nhân viên này đã thực hiện lập hóa đơn khách hàng hoặc tạo phiếu nhập/xuất kho, thao tác xóa sẽ bị hệ thống chặn lại vì vi phạm ràng buộc dữ liệu (Khoá ngoại). Bạn chỉ nên đổi mật khẩu hoặc đổi chức vụ của họ sang "Đã nghỉ việc" trong trường hợp đó.
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            Quay lại an toàn
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash me-2"></i> Xóa Vĩnh Viễn
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
