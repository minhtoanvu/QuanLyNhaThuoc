@model QLNhaThuoc.DTO.SanPham

@{
    ViewBag.Title = "Xóa Sản Phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 mt-4">
        <div class="card bg-dark border-danger shadow-sm rounded-4">
            <div class="card-header border-danger bg-transparent p-4 pb-0">
                <h5 class="text-danger mb-0"><i class="fa-solid fa-triangle-exclamation me-2"></i>Xác nhận xóa Sản Phẩm</h5>
            </div>
            
            <div class="card-body p-4 text-white">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mb-4">
                        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <p class="fs-5">Bạn có chắc chắn muốn xóa sản phẩm <strong>@Model.TenSP</strong> không?</p>
                <div class="bg-secondary bg-opacity-10 p-3 rounded-3 mb-4">
                    <p class="mb-1 text-muted small">Mã sản phẩm: <span class="text-white">@Model.MaSP</span></p>
                    <p class="mb-1 text-muted small">Giá bán: <span class="text-white">@Model.GiaBan.ToString("N0") ₫</span></p>
                    <p class="mb-0 text-muted small">Tồn kho hiện tại: <span class="text-white fw-bold">@Model.SoLuongTonKho</span></p>
                </div>

                @if(Model.SoLuongTonKho > 0)
                {
                    <div class="alert alert-warning border-warning">
                        <i class="fa-solid fa-bell me-2"></i><strong>Lưu ý:</strong> Sản phẩm này vẫn còn số lượng tồn kho. Không nên xóa nếu sản phẩm này đã liên kết với hóa đơn hoặc phiếu kho trước đó.
                    </div>
                }

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash me-2"></i> Xóa vĩnh viễn
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
