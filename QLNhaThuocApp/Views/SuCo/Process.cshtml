@using QLNhaThuoc.DAL
@model SuCoDAL.ChiTietSuCoDTO

@{
    ViewBag.Title = "Chi Tiết Nguồn Sự Cố";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row g-4 justify-content-center">
    <!-- Cột trái: Chi tiết thông tin -->
    <div class="col-12 col-lg-5">
        <div class="card bg-dark border-secondary shadow-sm rounded-4 h-100">
            <div class="card-header border-secondary p-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="text-white mb-0"><i class="fa-solid fa-file-lines me-2 text-primary"></i>Thông tin Sự Cố</h5>
                @if (Model.TrangThai == "Chờ xử lý")
                {
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">@Model.TrangThai</span>
                }
                else if (Model.TrangThai == "Đã xác nhận")
                {
                    <span class="badge bg-success px-3 py-2 rounded-pill">@Model.TrangThai</span>
                }
                else
                {
                    <span class="badge bg-danger px-3 py-2 rounded-pill">@Model.TrangThai</span>
                }
            </div>
            <div class="card-body p-4">
                <p class="text-muted small mb-1">Mã Phiếu</p>
                <p class="text-white fw-bold mb-3">@Model.MaBCSC</p>

                <p class="text-muted small mb-1">Thời Gian Ghi Nhận</p>
                <p class="text-white mb-3">@Model.NgayGui.ToString("dd/MM/yyyy HH:mm")</p>

                <p class="text-muted small mb-1">Khách Hàng</p>
                <div class="bg-secondary bg-opacity-10 p-3 rounded-3 mb-3">
                    <p class="text-white fw-bold mb-1">@Model.TenKH</p>
                    <p class="text-muted small mb-0"><i class="fa-solid fa-phone me-2"></i>@(Model.SoDT ?? "Không có số điện thoại")</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.MaHD))
                {
                    <p class="text-muted small mb-1">Mã Hóa Đơn Tranh Chấp</p>
                    <p class="text-info fw-bold mb-3"><i class="fa-solid fa-receipt me-2"></i>@Model.MaHD</p>
                }

                <p class="text-muted small mb-1">Nội Dung Sự Cố</p>
                <div class="bg-secondary bg-opacity-10 p-3 rounded-3 border border-secondary text-white">
                    @Model.NoiDung
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Xử lý -->
    <div class="col-12 col-lg-7">
        <div class="card bg-dark border-secondary shadow-sm rounded-4 h-100">
            <div class="card-header border-secondary p-4 pb-0">
                <h5 class="text-white mb-0"><i class="fa-solid fa-clipboard-check me-2 text-success"></i>Hồ Sơ Xử Lý</h5>
            </div>
            <div class="card-body p-4">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                @if (Model.TrangThai == "Chờ xử lý")
                {
                    using (Html.BeginForm("SubmitProcess", "SuCo", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MaBCSC" value="@Model.MaBCSC" />

                        <div class="mb-4">
                            <label class="form-label text-muted small">Nhập kết quả giải quyết / Phương án bồi thường <span class="text-danger">*</span></label>
                            <textarea name="KetQua" class="form-control text-white border-secondary bg-transparent" rows="6" required placeholder="Lưu lại phương án giải quyết cuối cùng cho quản lý hoặc bệnh nhân..."></textarea>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" name="Action" value="Cancel" class="btn btn-outline-danger flex-grow-1 py-3 fw-bold">
                                <i class="fa-solid fa-xmark me-2"></i> HỦY YÊU CẦU
                            </button>
                            <button type="submit" name="Action" value="Resolve" class="btn btn-success flex-grow-1 py-3 fw-bold">
                                <i class="fa-solid fa-check-double me-2"></i> ĐÓNG SỰ Cố (GIẢI QUYẾT)
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 mb-4 border-bottom border-secondary">
                        <i class="fa-regular fa-circle-check text-success fs-1 mb-3"></i>
                        <h5 class="text-white">Sự cố này đã đóng hồ sơ</h5>
                        <p class="text-muted small">Thời gian xử lý: @(Model.NgayXuLy?.ToString("dd/MM/yyyy HH:mm"))</p>
                    </div>

                    <p class="text-muted small mb-1">Người Xử Lý</p>
                    <p class="text-white bg-secondary bg-opacity-10 p-2 rounded-3 mb-3 d-inline-block px-3">
                        <i class="fa-solid fa-user-shield me-2 text-primary"></i>@Model.NguoiXuLy
                    </p>

                    <p class="text-muted small mb-1">Kết Quả Báo Cáo</p>
                    <div class="bg-secondary bg-opacity-10 p-3 rounded-3 border border-secondary text-white">
                        @Model.KetQua
                    </div>
                }

                <hr class="border-secondary my-4">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-2"></i> Trở Về Danh Sách
                </a>
            </div>
        </div>
    </div>
</div>
