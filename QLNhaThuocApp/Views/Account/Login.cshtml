@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập - PharmaManager</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0F172A;
            color: #F8FAFC;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .login-card {
            background-color: #1E293B;
            border-radius: 1.5rem;
            border: 1px solid #334155;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            overflow: hidden;
        }

        .login-image {
            background: linear-gradient(135deg, #4F46E5 0%, #312E81 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 3rem;
            text-align: center;
            position: relative;
        }

        .login-image::after {
            content: '';
            position: absolute;
            top: 0; right: 0; bottom: 0; left: 0;
            background: radial-gradient(circle at center, rgba(255,255,255,0.1) 0%, transparent 60%);
        }

        .login-image i {
            font-size: 5rem;
            color: white;
            margin-bottom: 1.5rem;
            filter: drop-shadow(0 0 10px rgba(255,255,255,0.3));
        }

        .login-image h3 {
            font-weight: 700;
            color: white;
            letter-spacing: 1px;
            font-size: 1.8rem;
            position: relative;
            z-index: 1;
        }

        .login-image p {
            color: rgba(255,255,255,0.8);
            font-weight: 300;
            position: relative;
            z-index: 1;
        }

        .login-form-container {
            padding: 3.5rem;
        }

        .login-form-container h4 {
            font-weight: 600;
            margin-bottom: 2rem;
            color: #F8FAFC;
        }

        .form-control {
            background-color: rgba(15, 23, 42, 0.6);
            border: 1px solid #334155;
            color: #F8FAFC;
            padding: 0.8rem 1rem;
            border-radius: 0.5rem;
        }

        .form-control:focus {
            background-color: rgba(15, 23, 42, 0.8);
            border-color: #4F46E5;
            color: #F8FAFC;
            box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.25);
        }

        .form-label {
            color: #94A3B8;
            font-weight: 500;
            font-size: 0.9rem;
        }

        .btn-primary {
            background-color: #4F46E5;
            border: none;
            padding: 0.8rem;
            font-weight: 600;
            border-radius: 0.5rem;
            transition: all 0.3s;
        }

        .btn-primary:hover {
            background-color: #4338CA;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-9 col-lg-10">
                <div class="card login-card border-0">
                    <div class="row g-0">
                        <div class="col-md-5 login-image d-none d-md-flex">
                            <i class="fa-solid fa-house-medical"></i>
                            <h3>PharmaManager</h3>
                            <p class="mt-2">Hệ thống quản lý nhà thuốc nội bộ thông minh và bảo mật.</p>
                        </div>
                        <div class="col-md-7 login-form-container">
                            <h4>Đăng Nhập Hệ Thống</h4>
                            
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger" style="background-color: rgba(220, 53, 69, 0.1); border-color: rgba(220, 53, 69, 0.2); color: #FF8A8A;">
                                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                                </div>
                            }

                            <form method="post" action="/Account/Login">
                                @if (ViewData["ReturnUrl"] != null)
                                {
                                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                                }
                                
                                <div class="mb-4">
                                    <label for="username" class="form-label">Tài Khoản</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-transparent border-end-0 border-secondary"><i class="fa-solid fa-user text-muted"></i></span>
                                        <input type="text" class="form-control border-start-0" id="username" name="tenDangNhap" placeholder="Nhập tài khoản" required autocomplete="off">
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label for="password" class="form-label">Mật Khẩu</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-transparent border-end-0 border-secondary"><i class="fa-solid fa-lock text-muted"></i></span>
                                        <input type="password" class="form-control border-start-0" id="password" name="matKhau" placeholder="********" required>
                                    </div>
                                </div>
                                <div class="d-grid mt-5">
                                    <button type="submit" class="btn btn-primary d-flex justify-content-center align-items-center gap-2">
                                        <i class="fa-solid fa-right-to-bracket"></i> ĐĂNG NHẬP
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
