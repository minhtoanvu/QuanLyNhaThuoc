@model QLNhaThuoc.DTO.KhachHang

@{
    ViewBag.Title = "Xóa Khách Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 mt-4">
        <div class="card bg-dark border-danger shadow-sm rounded-4">
            <div class="card-header border-danger bg-transparent p-4 pb-0">
                <h5 class="text-danger mb-0"><i class="fa-solid fa-user-xmark me-2"></i>Xác nhận Xóa Hồ Sơ Khách Hàng</h5>
            </div>
            
            <div class="card-body p-4 text-white">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mb-4">
                        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <p class="fs-5">Bạn có chắc chắn muốn xóa khách hàng <strong>@Model.Ho @Model.Ten</strong> không?</p>
                <div class="bg-secondary bg-opacity-10 p-3 rounded-3 mb-4">
                    <p class="mb-1 text-muted small">Mã Khách Hàng: <span class="text-white">@Model.MaKH</span></p>
                </div>

                <div class="alert alert-warning border-warning">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i><strong>Cảnh báo:</strong> Nếu bệnh nhân này đã có Hóa đơn hoặc Lịch sử Báo Cáo Sự Cố trên hệ thống, việc xóa sẽ bị thất bại do ràng buộc dữ liệu. Hãy xem xét việc cập nhật trạng thái hạng thành viên thành "Block".
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash me-2"></i> Xóa vĩnh viễn
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
