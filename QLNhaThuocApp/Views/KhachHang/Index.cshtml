@model IEnumerable<QLNhaThuoc.DTO.KhachHang>

@{
    ViewBag.Title = "Danh sách Khách Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table-container {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-top: 20px;
    }
    
    .header-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    
    .btn-primary {
        background-color: var(--primary-color);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    
    .btn-primary:hover {
        background-color: var(--primary-hover);
        color: white;
    }
    
    table {
        width: 100%;
        border-collapse: collapse;
    }
    
    th, td {
        padding: 16px;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-main);
    }
    
    th {
        background-color: rgba(0, 0, 0, 0.2);
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.5px;
    }
    
    tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.03);
    }
    
    .action-icons {
        display: flex;
        gap: 16px;
    }
    
    .action-icons a {
        color: var(--text-muted);
        transition: color 0.2s;
        font-size: 16px;
    }
    
    .action-icons a:hover {
        color: var(--primary-color);
    }
    
    .action-icons a.delete-btn:hover {
        color: #ef4444; 
    }
    
    .rank-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }
</style>

<div class="header-actions">
    <div>
        <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 8px;"><i class="fa-solid fa-users me-2 text-primary"></i>Quản Lý Khách Hàng</h2>
        <p style="color: var(--text-muted); font-size: 14px;">Quản lý hồ sơ, thẻ thành viên và điểm tích lũy của bệnh nhân.</p>
    </div>
    <a href="@Url.Action("Create")" class="btn-primary">
        <i class="fa-solid fa-user-plus"></i> Thêm Khách Hàng
    </a>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; color: #ef4444; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
        <i class="fa-solid fa-circle-exclamation" style="margin-right: 8px;"></i> @ViewBag.ErrorMessage
    </div>
}

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Mã KH</th>
                <th>Họ Tên</th>
                <th>Số ĐT</th>
                <th>Điểm Tích Lũy</th>
                <th>Hạng Thành Viên</th>
                <th style="width: 120px;">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td><strong style="color: var(--text-muted);">@item.MaKH</strong></td>
                        <td style="font-weight: 600; color: #F8FAFC;">@item.Ho @item.Ten</td>
                        <td><span style="color: var(--text-muted);">@item.SoDT</span></td>
                        <td class="fw-bold text-success">@item.DiemTichLuy <i class="fa-solid fa-coins small ms-1 text-warning"></i></td>
                        <td>
                            @if (item.HangThanhVien == "VIP" || item.HangThanhVien == "Vàng")
                            {
                                <span class="rank-badge" style="background: rgba(251, 191, 36, 0.15); color: #FBBF24;">@item.HangThanhVien</span>
                            }
                            else if(item.HangThanhVien == "Bạc")
                            {
                                <span class="rank-badge" style="background: rgba(156, 163, 175, 0.15); color: #9CA3AF;">@item.HangThanhVien</span>
                            }
                            else
                            {
                                <span class="rank-badge" style="background: rgba(52, 211, 153, 0.15); color: #34D399;">@item.HangThanhVien</span>
                            }
                        </td>
                        <td>
                            <div class="action-icons">
                                <a href="@Url.Action("Edit", new { id = item.MaKH })" title="Chỉnh sửa"><i class="fa-solid fa-pen-to-square"></i></a>
                                <a href="@Url.Action("Delete", new { id = item.MaKH })" class="delete-btn" title="Xóa"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="text-align: center; padding: 50px; color: var(--text-muted);">
                        <i class="fa-solid fa-users-slash" style="font-size: 48px; margin-bottom: 20px; opacity: 0.4;"></i>
                        <p style="font-size: 16px;">Chưa có khách hàng nào trong hệ thống.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
