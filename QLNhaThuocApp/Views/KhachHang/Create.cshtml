@model QLNhaThuoc.DTO.KhachHang

@{
    ViewBag.Title = "Thêm Khách Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row g-4 justify-content-center">
    <div class="col-12 col-md-8">
        <div class="card bg-dark border-secondary shadow-sm rounded-4">
            <div class="card-header border-secondary p-4 pb-0">
                <h5 class="text-white mb-0"><i class="fa-solid fa-user-plus me-2 text-primary"></i>Đăng Ký Thành Viên / Bệnh Nhân</h5>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

                    <div class="mb-3">
                        @Html.LabelFor(model => model.MaKH, "Mã Khách Hàng (Để trống sẽ tự động tạo)", htmlAttributes: new { @class = "form-label text-muted small" })
                        @Html.EditorFor(model => model.MaKH, new { htmlAttributes = new { @class = "form-control text-white border-secondary bg-transparent", placeholder = "Ví dụ: KH0001" } })
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Ho, "Họ Tên Đệm", htmlAttributes: new { @class = "form-label text-muted small" })
                            @Html.EditorFor(model => model.Ho, new { htmlAttributes = new { @class = "form-control text-white border-secondary bg-transparent", @required = "required" } })
                            @Html.ValidationMessageFor(model => model.Ho, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Ten, "Tên", htmlAttributes: new { @class = "form-label text-muted small" })
                            @Html.EditorFor(model => model.Ten, new { htmlAttributes = new { @class = "form-control text-white border-secondary bg-transparent", @required = "required" } })
                            @Html.ValidationMessageFor(model => model.Ten, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.SoDT, "Số Điện Thoại", htmlAttributes: new { @class = "form-label text-muted small" })
                            @Html.EditorFor(model => model.SoDT, new { htmlAttributes = new { @class = "form-control text-white border-secondary bg-transparent", type = "tel", @required = "required" } })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Email, "Email (Tùy chọn)", htmlAttributes: new { @class = "form-label text-muted small" })
                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control text-white border-secondary bg-transparent", type = "email" } })
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.DiaChi, "Địa Chỉ", htmlAttributes: new { @class = "form-label text-muted small" })
                        @Html.TextAreaFor(model => model.DiaChi, new { @class = "form-control text-white border-secondary bg-transparent", rows = 2 })
                    </div>

                    <hr class="border-secondary my-4">
                    
                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-left me-2"></i> Quay Lại
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fa-solid fa-save me-2"></i> Lưu Khách Hàng
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
